<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand_100"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/forest_900"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/compass_calibration_title"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/stepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_background"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:textColor="@color/forest_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <de.wandern.app.ui.FigureEightGuideView
                android:id="@+id/figureEightGuide"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/gestureSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="∞"
                android:textColor="@color/forest_700"
                android:textSize="104sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/forest_900"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/forest_700"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/sensorStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/forest_700"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/livePreviewHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/compass_calibration_live_preview"
                android:textColor="@color/forest_700"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <org.maplibre.android.maps.MapView
                android:id="@+id/mapPreview"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="10dp"
                android:background="@color/tour_thumbnail_placeholder"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:max="100"
                android:visibility="gone"
                app:indicatorColor="@color/moss_500"
                app:trackColor="@color/moss_300" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/forest_700"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondaryButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:textAllCaps="false"
                android:textColor="@color/forest_700"
                app:cornerRadius="16dp"
                app:strokeColor="@color/forest_700" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
