<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand_100">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/interactive_tour_map" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/forest_900"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dataPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/sand_50"
        app:cardElevation="8dp"
        app:behavior_draggable="true"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="48dp"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Wandern.BottomDrawer">

        <LinearLayout
            android:id="@+id/dataPanelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hideDataButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:alpha="0.65"
                    android:contentDescription="@string/hide_tour_data"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:padding="5dp"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/forest_700" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/panelToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                app:checkedButton="@id/primaryPanelButton"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primaryPanelButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:textColor="@color/tour_tab_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/tour_tab_background"
                    app:strokeColor="@color/forest_700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondaryPanelButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:textColor="@color/tour_tab_text"
                    android:textSize="12sp"
                    app:backgroundTint="@color/tour_tab_background"
                    app:strokeColor="@color/forest_700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wayTypesPanelButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/tour_map_way_types"
                    android:textAllCaps="false"
                    android:textColor="@color/tour_tab_text"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/tour_tab_background"
                    app:strokeColor="@color/forest_700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/surfacesPanelButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/tour_map_surfaces"
                    android:textAllCaps="false"
                    android:textColor="@color/tour_tab_text"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/tour_tab_background"
                    app:strokeColor="@color/forest_700" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/panelSummary"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textColor="@color/forest_700"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp">

                <de.wandern.app.ui.ProfileChartView
                    android:id="@+id/profileChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/forecastDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingExtra="8dp"
                    android:padding="20dp"
                    android:textColor="@color/forest_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <de.wandern.app.ui.RouteAttributesView
                    android:id="@+id/routeAttributesView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
