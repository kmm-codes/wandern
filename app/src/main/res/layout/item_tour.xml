<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/sand_50"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#1F1E4D3C"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tourNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/forest_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tourDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/forest_700"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/offlineStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/offline_map_checking"
            android:textColor="@color/forest_700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openTourButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/open_tour"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                app:backgroundTint="@color/forest_700"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/offlineMapButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1.35"
                android:enabled="false"
                android:maxLines="1"
                android:text="@string/offline_map_checking_short"
                android:textAllCaps="false"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform"
                app:cornerRadius="12dp"
                app:strokeColor="@color/forest_700" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tourMoreButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/tour_actions"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:padding="12dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_more"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="@color/forest_700" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
