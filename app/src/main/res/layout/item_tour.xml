<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/sand_50"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#1F1E4D3C"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="124dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="112dp"
            android:layout_height="104dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/mapThumbnailContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/mapThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/tour_thumbnail_placeholder"
                    android:scaleType="centerCrop" />

                <ProgressBar
                    android:id="@+id/thumbnailProgress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/forest_700" />

                <TextView
                    android:id="@+id/offlineStatusText"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/offlineMapButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="2dp"
                    android:alpha="0.68"
                    android:contentDescription="@string/offline_map_checking"
                    android:enabled="false"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="8dp"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_offline_download"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="19dp"
                    app:iconTint="@color/forest_900"
                    app:rippleColor="@color/moss_300" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tourNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/forest_900"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tourDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:maxLines="3"
                    android:paddingEnd="38dp"
                    android:textColor="@color/forest_700"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tourMoreButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:alpha="0.78"
                android:contentDescription="@string/tour_actions"
                android:tooltipText="@string/tour_actions"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_more"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="19dp"
                app:iconTint="@color/forest_700"
                app:rippleColor="@color/moss_300" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
